
# UYGULAMA GENEL AYARLARI
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173

# Geliştirme/Test Modları (Production'da false olmalı)
MOCK_RETRIEVAL=false
MOCK_LLM=false

# VERİTABANI VE GÜVENLİK (JWT)
DATABASE_URL=postgresql+psycopg://username:password@localhost/db_name
JWT_SECRET_KEY=change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# LLM (GROQ) VE VECTOR DB (QDRANT) AYARLARI
GROQ_API_KEY=your_groq_api_key_here
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=hukuk_chunks

# RAG VE EMBEDDING PARAMETRELERİ
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_MODE=local
EMBEDDING_SERVICE_URL=
EMBEDDING_SERVICE_API_KEY=
EMBEDDING_TIMEOUT_MS=2000
SCORE_THRESHOLD=0.65

# PRODUCTION POLICY FLAGS
STRICT_UPSTREAMS=false
ALLOW_LOCAL_RETRIEVAL_FALLBACK=true
