# --- Python / Backend (FastAPI) ---
# Hangi dizinde olursa olsun tüm derlenmiş dosyaları ve önbellek klasörlerini yoksay
__pycache__/
*.py[cod]
*$py.class

# Sanal ortamlar
backend/venv/
backend/.venv/
venv/
env/

# Çevresel değişkenler
.env
backend/.env

# Veri klasörleri (Sadece içindekileri yoksay, klasörü tut)
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep

# --- Node / Frontend (React) ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local

# --- İşletim Sistemi & IDE ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Vektör Veritabanı & Geçici Dosyalar ---
*.log
backend/to_delete.txt
.claude